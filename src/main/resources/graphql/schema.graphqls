type Category {
    id: ID!
    name: String
    images: String
    products: [Product]
}

type User {
    id: ID!
    fullname: String
    email: String
    phone: String
}

type Product {
    id: ID!
    title: String
    quantity: Int
    desc: String
    price: Float
    category: Category
    user: User
}

input CategoryInput {
    name: String!
    images: String
}

input ProductInput {
    title: String!
    quantity: Int!
    desc: String
    price: Float!
    categoryId: ID!
    userId: ID
}

type Query {
    # 1. Hiển thị tất cả product có price từ thấp đến cao
    allProductsByPriceAsc: [Product]
    
    # 2. Lấy tất cả product của 01 category
    productsByCategory(categoryId: ID!): [Product]
    
    # Lấy tất cả / chi tiết Category & Product
    allCategories: [Category]
    categoryById(id: ID!): Category
    allProducts: [Product]
    productById(id: ID!): Product
}

type Mutation {
    # CRUD Category
    createCategory(input: CategoryInput!): Category
    updateCategory(id: ID!, input: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean

    # CRUD Product
    createProduct(input: ProductInput!): Product
    updateProduct(id: ID!, input: ProductInput!): Product
    deleteProduct(id: ID!): Boolean
}